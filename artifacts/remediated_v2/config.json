{
  "random_seed": 42,
  "data_path": "cardio_train_fixed (1).csv",
  "target_column": "cardio",
  "positive_class": 1,
  "negative_class": 0,
  "identifier_columns": [
    "id"
  ],
  "drop_columns": [
    "bp_category_encoded",
    "bp_category"
  ],
  "group_column": null,
  "test_size": 0.2,
  "n_splits": 5,
  "shuffle_folds": true,
  "scaling_strategy": "robust",
  "outlier_clipping": true,
  "outlier_factor": 1.5,
  "numeric_imputation_strategy": "median",
  "categorical_imputation_strategy": "most_frequent",
  "enable_feature_engineering": true,
  "reduction_strategy": "none",
  "reduction_k": 15,
  "pca_components": 10,
  "artifacts_dir": "artifacts/remediated_v2",
  "external_data_path": "framingham.csv",
  "tune_hyperparameters": true,
  "tuning_iter": 10,
  "tuning_cv": 3,
  "model_params": {
    "lr_c": 1.0,
    "lr_max_iter": 1000,
    "lr_solver": "lbfgs",
    "svm_c": 1.0,
    "svm_max_iter": 2000,
    "svm_calibration_method": "sigmoid",
    "svm_calibration_cv": 3,
    "rf_n_estimators": 100,
    "rf_max_depth": 12,
    "rf_min_samples_split": 10,
    "rf_min_samples_leaf": 4,
    "rf_n_jobs": -1,
    "gb_max_iter": 100,
    "gb_learning_rate": 0.08,
    "gb_max_depth": 6,
    "gb_min_samples_leaf": 20,
    "mlp_hidden_layer_sizes": [
      64,
      32
    ],
    "mlp_activation": "relu",
    "mlp_alpha": 0.001,
    "mlp_max_iter": 100,
    "mlp_early_stopping": true,
    "mlp_n_iter_no_change": 10,
    "xgb_n_estimators": 200,
    "xgb_max_depth": 6,
    "xgb_learning_rate": 0.05,
    "xgb_subsample": 0.8,
    "xgb_colsample_bytree": 0.8,
    "lgb_n_estimators": 200,
    "lgb_num_leaves": 31,
    "lgb_learning_rate": 0.05,
    "lgb_subsample": 0.8,
    "lgb_colsample_bytree": 0.8,
    "cat_iterations": 200,
    "cat_depth": 6,
    "cat_learning_rate": 0.05,
    "cat_features": [
      "gender",
      "cholesterol",
      "gluc"
    ]
  }
}